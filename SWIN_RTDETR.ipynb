        "    VAL_EACH_EPOCH = os.environ.get(\"VAL_EACH_EPOCH\", \"1\") != \"0\"\n",
        "    CLOSE_MOSAIC = 0\n",
        "\n",
        "    # ---- Augmentation -----------------------------------------------------------------\n",
        "    # Choose the preset the BASELINE used; the baseline diff below shows any mismatch.\n",
        "    #   conservative        : your original setting (no flips, no mosaic)\n",
        "    #   conservative_flip   : same + horizontal flip\n",
        "    #   ultralytics_default : no overrides (mosaic 1.0, fliplr 0.5, HSV, ...)\n",
        "    _BASE_AUG = {\n",
        "        \"hsv_h\": 0.0, \"hsv_s\": 0.0, \"hsv_v\": 0.0,\n",
        "        \"degrees\": 0.0, \"translate\": 0.05, \"scale\": 0.2,\n",
        "        \"shear\": 0.0, \"perspective\": 0.0,\n",
        "        \"flipud\": 0.0, \"fliplr\": 0.0, \"bgr\": 0.0,\n",
        "        \"mosaic\": 0.0, \"mixup\": 0.0, \"cutmix\": 0.0, \"copy_paste\": 0.0,\n",
        "    }\n",
        "    AUG_PRESETS = {\n",
        "        \"conservative\": _BASE_AUG,\n",
        "        \"conservative_flip\": {**_BASE_AUG, \"fliplr\": 0.5},\n",
        "        \"ultralytics_default\": {},\n",
        "    }\n",
        "    AUG_PRESET = os.environ.get(\"AUG_PRESET\", \"conservative\")\n",
        "    AUG = AUG_PRESETS[AUG_PRESET]\n",
        "\n",
        "    # ---- Loss -------------------------------------------------------------------------\n",
        "    # \"focal_ciou\": sigmoid focal loss (classification) + CIoU (boxes) + L1\n",
        "    # \"native\"    : Ultralytics RT-DETR default = varifocal loss + GIoU + L1\n",
        "    LOSS = os.environ.get(\"LOSS\", \"focal_ciou\").strip().lower()\n",
        "    FOCAL_GAMMA = float(os.environ.get(\"FOCAL_GAMMA\", 2.0))\n",
        "    FOCAL_ALPHA = float(os.environ.get(\"FOCAL_ALPHA\", 0.75))\n",
        "    # weights (Ultralytics defaults): classification 1, L1 box 5, IoU-type box term 2\n",
        "    # (used for focal_ciou only; \"native\" always uses the Ultralytics defaults)\n",
        "    LOSS_GAIN = {\n",
        "        \"class\": float(os.environ.get(\"CLS_GAIN\", 1.0)),\n",
        "        \"bbox\": float(os.environ.get(\"BBOX_GAIN\", 5.0)),\n",
        "        \"giou\": float(os.environ.get(\"IOU_GAIN\", 2.0)),\n",
        "        \"no_object\": 0.1, \"mask\": 1.0, \"dice\": 1.0,\n",
        "    }\n",
        "    assert LOSS in (\"focal_ciou\", \"native\"), f\"LOSS must be 'focal_ciou' or 'native', got {LOSS!r}\"\n",
        "\n",
        "    # ---- Evaluation -------------------------------------------------------------------\n",
        "    CONF_THRESH_MAP = 0.001                         # mAP is computed at this confidence\n",
        "    CONF_THRESH_OP = 0.50                           # operating point, read from the PR curves\n",
        "\n",
        "    # ---- Output -------------------------------------------------------------------------\n",
        "    PROJECT_DIR = os.environ.get(\"PROJECT_DIR\", \"/content/runs_swin_rtdetr\")\n",
        "    DOWNLOAD_SMALL_BUNDLE = True\n",
        "\n",
        "    # ---- Baseline comparison -----------------------------------------------------------\n",
        "    # Path to the baseline run's args.yaml (e.g. .../runs/detect/<baseline_run>/args.yaml)\n",
        "    BASELINE_ARGS_YAML = os.environ.get(\"BASELINE_ARGS_YAML\", \"\")\n",
        "    INHERIT_FROM_BASELINE = True\n",
        "\n",
        "    # ---- Resume after a Colab disconnect -----------------------------------------------\n",
        "    # Put PROJECT_DIR on Google Drive, then set this to <run>/weights/last.pt and re-run the cell.\n",
        "    RESUME_FROM = os.environ.get(\"RESUME_FROM\", \"\")\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# 0b) INSTALL + BASIC IMPORTS\n",
        "# ==============================================================================\n",
        "\n",
        "def _pip(*pkgs):\n",
        "    subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", *pkgs])\n",
        "\n",
        "\n",
        "if \"ultralytics\" in sys.modules:\n",
        "    print(\"NOTE: ultralytics was already imported in this runtime. If you changed a version \"\n",
        "          \"in CFG, restart the runtime and run this cell again.\")\n",
        "\n",
        "_pip(\n",
        "    f\"ultralytics=={CFG.ULTRALYTICS_VERSION}\" if CFG.ULTRALYTICS_VERSION else \"ultralytics\",\n",
        "    f\"timm=={CFG.TIMM_VERSION}\" if CFG.TIMM_VERSION else \"timm\",\n",
        "    \"pyyaml\",\n",
        ")\n",
        "importlib.invalidate_caches()\n",
        "\n",
        "import numpy as np\n",
        "import torch\n",
        "import yaml\n",
        "\n",
        "random.seed(CFG.SEED)\n",
        "np.random.seed(CFG.SEED)\n",
        "torch.manual_seed(CFG.SEED)\n",
        "if torch.cuda.is_available():\n",
        "    torch.cuda.manual_seed_all(CFG.SEED)\n",
        "\n",
        "DEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "print(\"python\", platform.python_version(), \"| torch\", torch.__version__, \"| device\", DEVICE,\n",
        "      \"|\", torch.cuda.get_device_name(0) if DEVICE.type == \"cuda\" else \"no GPU\")\n",
        "if DEVICE.type != \"cuda\":\n",
        "    print(\"WARNING: no GPU found (Runtime > Change runtime type > GPU).\")\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# 1) SWIN BACKBONE MODULE  (written into the Ultralytics package)\n",
        "# ==============================================================================\n",
        "\n",
        "SWIN_SRC = r'''\n",
        "import inspect\n",
        "\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import timm\n",
        "from timm.models.swin_transformer import SwinTransformer\n",
        "\n",
        "\n",
        "class SwinBackbone(nn.Module):\n",
        "    \"\"\"Swin backbone returning [P3, P4, P5] as NCHW tensors.\n",
        "\n",
        "    For Swin-B: P3 = stride 8 (256 ch), P4 = stride 16 (512 ch), P5 = stride 32 (1024 ch).\n",
        "\n",
        "    YAML args: [model_name, pretrained, img_size, window_size, drop_path_rate,\n",
        "                grad_checkpointing]\n",
        "\n",
        "    Input: RGB in [0, 1] (Ultralytics convention). ImageNet mean/std are applied here\n",
        "    because the timm weights were trained with that normalisation.\n",
        "    img_size is baked into Swin's attention masks: train / validate / predict at\n",
        "    exactly this size.\n",
        "    \"\"\"\n",
        "\n",
        "    def __init__(\n",
        "        self,\n",
        "        model_name=\"swin_base_patch4_window12_384.ms_in22k_ft_in1k\",\n",
        "        pretrained=True,\n",
        "        img_size=640,\n",
        "        window_size=12,\n",
        "        drop_path_rate=0.1,\n",
        "        grad_checkpointing=False,\n",
        "    ):\n",
        "        super().__init__()\n",
        "\n",
        "        accepted = set(inspect.signature(SwinTransformer.__init__).parameters)\n",
        "        kwargs = {\n",
        "            \"pretrained\": pretrained,\n",
        "            \"features_only\": True,\n",
        "            \"img_size\": img_size,\n",
        "            \"window_size\": window_size,\n",
        "            \"drop_path_rate\": drop_path_rate,\n",
        "        }\n",
        "        if \"strict_img_size\" in accepted:          # only newer timm versions have it\n",
        "            kwargs[\"strict_img_size\"] = False\n",
        "\n",
        "        self.swin = timm.create_model(model_name, **kwargs)\n",
        "\n",
        "        channels = list(self.swin.feature_info.channels())\n",
        "        reductions = list(self.swin.feature_info.reduction())\n",
        "        if len(channels) < 4:\n",
        "            raise RuntimeError(f\"Expected 4 Swin stages, got channels={channels}\")\n",
        "\n",
        "        # stage 0 (stride 4) is skipped; stages 1-3 are P3 / P4 / P5\n",
        "        self.return_idx = [1, 2, 3]\n",
        "        self.out_channels = [channels[i] for i in self.return_idx]\n",
        "        self.out_reductions = [reductions[i] for i in self.return_idx]\n",
        "\n",
        "        if grad_checkpointing and hasattr(self.swin, \"set_grad_checkpointing\"):\n",
        "            self.swin.set_grad_checkpointing(True)\n",
        "\n",
        "        self.register_buffer(\n",
        "            \"mean\", torch.tensor([0.485, 0.456, 0.406]).view(1, 3, 1, 1), persistent=False\n",
        "        )\n",
        "        self.register_buffer(\n",
        "            \"std\", torch.tensor([0.229, 0.224, 0.225]).view(1, 3, 1, 1), persistent=False\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "        x = (x - self.mean.to(x.dtype)) / self.std.to(x.dtype)\n",
        "        feats = self.swin(x)\n",
        "\n",
        "        outs = []\n",
        "        for i, c in zip(self.return_idx, self.out_channels):\n",
        "            f = feats[i]\n",
        "            if f.shape[1] != c and f.shape[-1] == c:   # timm Swin returns NHWC\n",
        "                f = f.permute(0, 3, 1, 2).contiguous()\n",
        "            outs.append(f)\n",
        "        return outs\n",
        "'''\n",
        "\n",
        "_spec = importlib.util.find_spec(\"ultralytics\")\n",
        "if _spec is None:\n",
        "    raise RuntimeError(\"Ultralytics could not be found after installation.\")\n",
        "\n",
        "ULTRA_ROOT = Path(list(_spec.submodule_search_locations)[0])\n",
        "SWIN_MODULE = ULTRA_ROOT / \"nn\" / \"modules\" / \"swin_backbone.py\"\n",
        "SWIN_MODULE.write_text(SWIN_SRC.lstrip())\n",
        "print(\"Swin module written to:\", SWIN_MODULE)\n",
        "\n",
        "LOSS_SRC = r'''\n",
        "import torch.nn as nn\n",
        "import torch.nn.functional as F\n",
        "\n",
        "from ultralytics.models.utils.loss import RTDETRDetectionLoss\n",
        "from ultralytics.utils.metrics import bbox_iou\n",
        "\n",
        "\n",
        "class SigmoidFocalLoss(nn.Module):\n",
        "    \"\"\"Sigmoid focal loss (Lin et al., 2017) with hard 0/1 targets.\n",
        "\n",
        "    Same reduction as Ultralytics' DETR classification loss (mean over queries, sum over\n",
        "    batch and classes); DETRLoss then divides by the number of ground-truth boxes.\n",
        "    \"\"\"\n",
        "\n",
        "    def __init__(self, gamma=2.0, alpha=0.25):\n",
        "        super().__init__()\n",
        "        self.gamma = float(gamma)\n",
        "        self.alpha = float(alpha)\n",
        "        self.calls = 0                      # counts uses (evidence for the self-test)\n",
        "\n",
        "    def forward(self, pred, label):\n",
        "        self.calls += 1\n",
        "        pred, label = pred.float(), label.float()          # logits / one-hot, (B, Q, C)\n",
        "        loss = F.binary_cross_entropy_with_logits(pred, label, reduction=\"none\")\n",
        "        prob = pred.sigmoid()\n",
        "        p_t = label * prob + (1.0 - label) * (1.0 - prob)\n",
        "        loss = loss * (1.0 - p_t) ** self.gamma\n",
        "        if self.alpha >= 0:\n",
        "            loss = loss * (label * self.alpha + (1.0 - label) * (1.0 - self.alpha))\n",
        "        return loss.mean(1).sum()\n",
        "\n",
        "\n",
        "class FocalCIoURTDETRLoss(RTDETRDetectionLoss):\n",
        "    \"\"\"RT-DETR loss with focal classification loss and CIoU box loss.\n",
        "\n",
        "    Differences from Ultralytics' default RTDETRDetectionLoss(use_vfl=True):\n",
        "      * classification: sigmoid focal loss (hard targets) instead of varifocal loss\n",
        "      * box regression: 1 - CIoU instead of 1 - GIoU (the L1 term is unchanged)\n",
        "    The Hungarian matcher cost (class + L1 + GIoU) is left unchanged. The loss keys keep\n",
        "    their original names (\"loss_giou\" now holds the CIoU term) because the RT-DETR model\n",
        "    reads those keys for logging.\n",
        "    \"\"\"\n",
        "\n",
        "    def __init__(self, nc=80, gamma=2.0, alpha=0.25, loss_gain=None, **kwargs):\n",
        "        kwargs.update(use_fl=True, use_vfl=False)\n",
        "        if loss_gain is not None:\n",
        "            kwargs[\"loss_gain\"] = loss_gain\n",
        "        super().__init__(nc=nc, **kwargs)\n",
        "        self.vfl = None\n",
        "        self.fl = SigmoidFocalLoss(gamma, alpha)\n",
        "        self.n_ciou_calls = 0\n",
        "\n",
        "    def _get_loss_bbox(self, pred_bboxes, gt_bboxes, postfix=\"\"):\n",
        "        self.n_ciou_calls += 1\n",
        "        name_bbox = f\"loss_bbox{postfix}\"\n",
        "        name_giou = f\"loss_giou{postfix}\"           # holds the CIoU loss\n",
        "\n",
        "        loss = {}\n",
        "        if len(gt_bboxes) == 0:\n",
        "            # keeps every prediction in the graph (multi-GPU \"unused gradient\" safe)\n",
        "            loss[name_bbox] = pred_bboxes[..., :0].sum()\n",
        "            loss[name_giou] = pred_bboxes[..., :0].sum()\n",
        "            return loss\n",
        "\n",
        "        loss[name_bbox] = self.loss_gain[\"bbox\"] * F.l1_loss(pred_bboxes, gt_bboxes, reduction=\"sum\") / len(gt_bboxes)\n",
        "        ciou = bbox_iou(pred_bboxes, gt_bboxes, xywh=True, CIoU=True)\n",
        "        loss[name_giou] = self.loss_gain[\"giou\"] * (1.0 - ciou).sum() / len(gt_bboxes)\n",
        "        return {k: v.squeeze() for k, v in loss.items()}\n",
        "'''\n",
        "\n",
        "LOSS_MODULE = ULTRA_ROOT / \"models\" / \"utils\" / \"focal_ciou_loss.py\"\n",
        "LOSS_MODULE.write_text(LOSS_SRC.lstrip())\n",
        "print(\"Loss module written to:\", LOSS_MODULE)\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# 2) SMOKE TEST: Swin must return P3/P4/P5 (NCHW) at the chosen size\n",
        "# ==============================================================================\n",
        "\n",
        "importlib.invalidate_caches()\n",
        "_mspec = importlib.util.spec_from_file_location(\"swin_backbone_smoketest\", SWIN_MODULE)\n",
        "_mod = importlib.util.module_from_spec(_mspec)\n",
        "_mspec.loader.exec_module(_mod)\n",
        "\n",
        "IMG_SIZE = None\n",
        "SWIN_WINDOW = None\n",
        "SWIN_WEIGHTS_SOURCE = \"unresolved\"\n",
        "APPLIED_DROP_PATH = None\n",
        "SWIN_PARAMS_M = None\n",
        "smoke_attempts = []\n",
        "\n",
        "_candidates = [(CFG.IMG_SIZE, CFG.SWIN_WINDOW)]\n",
        "if CFG.ALLOW_FALLBACK:\n",
        "    _candidates += [c for c in CFG.FALLBACKS if c not in _candidates]\n",
        "\n",
        "print(\"\\n\" + \"=\" * 78)\n",
        "print(f\"SWIN SMOKE TEST: candidates (imgsz, window) = {_candidates}\")\n",
        "print(\"=\" * 78)\n",
        "\n",
        "_bb = None\n",
        "for _size, _window in _candidates:\n",
        "    try:\n",
        "        _bb = _mod.SwinBackbone(\n",
        "            CFG.SWIN_MODEL, CFG.SWIN_PRETRAINED, _size, _window,\n",
        "            CFG.SWIN_DROP_PATH_RATE, CFG.SWIN_GRAD_CKPT,\n",
        "        ).eval()\n",
        "\n",
        "        _chs = list(_bb.out_channels)\n",
        "        if (_bb.out_reductions != CFG.SWIN_EXPECTED_REDUCTIONS\n",
        "                or (CFG.SWIN_EXPECTED_CHANNELS and _chs != CFG.SWIN_EXPECTED_CHANNELS)):\n",
        "            raise RuntimeError(\n",
        "                f\"channels/reductions {_chs}/{_bb.out_reductions}, expected \"\n",
        "                f\"{CFG.SWIN_EXPECTED_CHANNELS or 'auto'}/{CFG.SWIN_EXPECTED_REDUCTIONS}\"\n",
        "            )\n",
        "\n",
        "        with torch.no_grad():\n",
        "            _outs = _bb(torch.rand(1, 3, _size, _size))\n",
        "\n",
        "        _shapes = [tuple(o.shape) for o in _outs]\n",
        "        _expected = [\n",
        "            (1, c, _size // r, _size // r)\n",
        "            for c, r in zip(_chs, CFG.SWIN_EXPECTED_REDUCTIONS)\n",
        "        ]\n",
        "        if _shapes != _expected:\n",
        "            raise RuntimeError(f\"feature shapes {_shapes}, expected {_expected}\")\n",
        "\n",
        "        _pcfg = getattr(_bb.swin, \"pretrained_cfg\", None) or {}\n",
        "        SWIN_WEIGHTS_SOURCE = (\n",
        "            _pcfg.get(\"hf_hub_id\") or _pcfg.get(\"url\") or _pcfg.get(\"file\") or \"unresolved\"\n",
        "        )\n",
        "        _dp = [float(m.drop_prob) for m in _bb.swin.modules() if m.__class__.__name__ == \"DropPath\"]\n",
        "        APPLIED_DROP_PATH = max(_dp) if _dp else 0.0\n",
        "        SWIN_PARAMS_M = round(sum(p.numel() for p in _bb.parameters()) / 1e6, 2)\n",
        "\n",
        "        smoke_attempts.append(\n",
        "            {\"img_size\": _size, \"window_size\": _window, \"ok\": True, \"shapes\": _shapes}\n",
        "        )\n",
        "        IMG_SIZE, SWIN_WINDOW = _size, _window\n",
        "        CFG.SWIN_EXPECTED_CHANNELS = _chs          # used by the model YAML below\n",
        "        print(f\"[OK] imgsz={_size} window={_window} features={_shapes}\")\n",
        "        break\n",
        "\n",
        "    except Exception as exc:\n",
        "        smoke_attempts.append({\n",
        "            \"img_size\": _size, \"window_size\": _window, \"ok\": False,\n",
        "            \"error\": f\"{type(exc).__name__}: {exc}\"[:500],\n",
        "        })\n",
        "        print(f\"[FAILED] imgsz={_size} window={_window}: {type(exc).__name__}: {exc}\")\n",
        "\n",
        "del _bb\n",
        "gc.collect()\n",
        "\n",
        "if IMG_SIZE is None:\n",
        "    raise RuntimeError(\n",
        "        \"No Swin candidate worked (details above). Options: newer timm (TIMM_VERSION=''), \"\n",
        "        \"CFG.SWIN_WINDOW = 10 (160/80/40/20 are divisible by 10), or ALLOW_FALLBACK = True.\"\n",
        "    )\n",
        "if IMG_SIZE != CFG.IMG_SIZE:\n",
        "    print(f\"WARNING: training at {IMG_SIZE}px instead of {CFG.IMG_SIZE}px - the baseline \"\n",
        "          \"must use the same size for a fair comparison.\")\n",
        "\n",
        "print(\"Swin variant        :\", CFG.SWIN_VARIANT, \"|\", CFG.SWIN_MODEL)\n",
        "print(\"Swin P3/P4/P5 ch    :\", CFG.SWIN_EXPECTED_CHANNELS)\n",
        "print(\"Selected input size :\", IMG_SIZE)\n",
        "print(\"Selected Swin window:\", SWIN_WINDOW)\n",
        "print(\"Swin params (M)     :\", SWIN_PARAMS_M)\n",
        "print(\"Applied drop path   :\", APPLIED_DROP_PATH)\n",
        "print(\"Pretrained weights  :\", SWIN_WEIGHTS_SOURCE)\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# 3) DATASET\n",
        "# ==============================================================================\n",
        "\n",
        "PROJECT_DIR = Path(CFG.PROJECT_DIR)\n",
        "PROJECT_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "\n",
        "def find_local_dataset():\n",
        "    \"\"\"data.yaml of the exact Roboflow project/version if already on disk, else None.\"\"\"\n",
        "    if CFG.DATA_YAML:\n",
        "        p = Path(CFG.DATA_YAML)\n",
        "        if not p.exists():\n",
        "            raise FileNotFoundError(f\"CFG.DATA_YAML not found: {p}\")\n",
        "        return p\n",
        "\n",
        "    wanted_dir = f\"{CFG.RF_PROJECT}-{CFG.RF_VERSION}\".lower()\n",
        "    for y in sorted(Path(\"/content\").glob(\"*/data.yaml\")):\n",
        "        try:\n",
        "            meta = (yaml.safe_load(y.read_text()) or {}).get(\"roboflow\") or {}\n",
        "        except Exception:\n",
        "            meta = {}\n",
        "        if meta:\n",
        "            ok = (str(meta.get(\"project\", \"\")).lower() == CFG.RF_PROJECT.lower()\n",
        "                  and str(meta.get(\"version\", \"\")) == str(CFG.RF_VERSION))\n",
        "        else:\n",
        "            ok = y.parent.name.lower() == wanted_dir\n",
        "        if ok:\n",
        "            return y\n",
        "    return None\n",
        "\n",
        "\n",
        "DATA_YAML = find_local_dataset()\n",
        "\n",
        "if DATA_YAML is None:\n",
        "    _key = os.environ.get(\"ROBOFLOW_API_KEY\")\n",
        "    if not _key:\n",
        "        try:\n",
        "            from google.colab import userdata\n",
        "            _key = userdata.get(\"ROBOFLOW_API_KEY\")\n",
        "        except Exception:\n",
        "            _key = None\n",
        "    _key = _key or input(\"Enter your Roboflow API key: \").strip()\n",
        "\n",
        "    _pip(\"roboflow\")\n",
        "    from roboflow import Roboflow\n",
        "\n",
        "    _rf_project = Roboflow(api_key=_key).workspace(CFG.RF_WORKSPACE).project(CFG.RF_PROJECT)\n",
        "    # keep this export format identical to the baseline\n",
        "    _rf_dataset = _rf_project.version(CFG.RF_VERSION).download(\"yolov11\")\n",
        "    DATA_YAML = Path(_rf_dataset.location) / \"data.yaml\"\n",
        "\n",
        "if not DATA_YAML.exists():\n",
        "    raise FileNotFoundError(f\"data.yaml not found: {DATA_YAML}\")\n",
        "\n",
        "DATA_ROOT = DATA_YAML.parent\n",
        "with open(DATA_YAML, \"r\") as f:\n",
        "    data_cfg = yaml.safe_load(f)\n",
        "\n",
        "_names = data_cfg.get(\"names\", {})\n",
        "if isinstance(_names, dict):\n",
        "    CLASS_NAMES = [_names[k] for k in sorted(_names, key=lambda x: int(x))]\n",
        "else:\n",
        "    CLASS_NAMES = list(_names)\n",
        "\n",
        "NUM_CLASSES = len(CLASS_NAMES)\n",
        "\n",
        "\n",
        "def _has_images(path):\n",
        "    path = Path(path)\n",
        "    if path.is_file():\n",
        "        return True\n",
        "    if path.is_dir():\n",
        "        exts = {\".jpg\", \".jpeg\", \".png\", \".bmp\", \".tif\", \".tiff\", \".webp\"}\n",
        "        return any(f.suffix.lower() in exts for f in path.iterdir())\n",
        "    return False\n",
        "\n",
        "\n",
        "def split_available(key):\n",
        "    \"\"\"True only if data.yaml[key] points to a folder/list that really contains images.\n",
        "    (Roboflow always writes a `test:` entry, even when the folder is empty or missing.)\"\"\"\n",
        "    raw = data_cfg.get(key)\n",
        "    if not raw:\n",
        "        return False\n",
        "    for r in ([raw] if isinstance(raw, str) else list(raw)):\n",
        "        r = str(r)\n",
        "        if os.path.isabs(r):\n",
        "            cands = [Path(r)]\n",
        "        else:\n",
        "            cands = [DATA_ROOT / r, DATA_ROOT / (r[3:] if r.startswith(\"../\") else r)]\n",
        "        if not any(_has_images(c) for c in cands):\n",
        "            return False\n",
        "    return True\n",
        "\n",
        "\n",
        "EVAL_SPLIT = \"test\" if split_available(\"test\") else \"val\"\n",
        "if data_cfg.get(\"test\") and EVAL_SPLIT == \"val\":\n",
        "    print(\"WARNING: data.yaml lists a test split but it has no images; evaluating on val.\")\n",
        "\n",
        "print(\"\\nDataset          :\", DATA_ROOT)\n",
        "print(\"data.yaml        :\", DATA_YAML)\n",
        "print(\"Classes          :\", CLASS_NAMES)\n",
        "print(\"Number of classes:\", NUM_CLASSES)\n",
        "print(\"Evaluation split :\", EVAL_SPLIT)\n",
        "\n",
        "\n",
        "def box_stats(root, split=\"train\", imgsz=IMG_SIZE):\n",
        "    \"\"\"Statistics of normalised YOLO boxes rescaled to imgsz.\"\"\"\n",
        "    label_dir = Path(root) / split / \"labels\"\n",
        "    if not label_dir.exists():\n",
        "        return {\"split\": split, \"error\": f\"Missing directory: {label_dir}\"}\n",
        "\n",
        "    short_sides, widths, heights = [], [], []\n",
        "    for label_file in label_dir.glob(\"*.txt\"):\n",
        "        for line in label_file.read_text().splitlines():\n",
        "            parts = line.split()\n",
        "            if len(parts) < 5:\n",
        "                continue\n",
        "            try:\n",
        "                w, h = float(parts[3]) * imgsz, float(parts[4]) * imgsz\n",
        "            except ValueError:\n",
        "                continue\n",
        "            widths.append(w)\n",
        "            heights.append(h)\n",
        "            short_sides.append(min(w, h))\n",
        "\n",
        "    if not short_sides:\n",
        "        return {\"split\": split, \"imgsz\": imgsz, \"n_boxes\": 0}\n",
        "\n",
        "    s = np.asarray(short_sides)\n",
        "    return {\n",
        "        \"split\": split,\n",
        "        \"imgsz\": imgsz,\n",
        "        \"n_boxes\": int(len(s)),\n",
        "        \"median_short_side_px\": round(float(np.median(s)), 2),\n",
        "        \"mean_short_side_px\": round(float(np.mean(s)), 2),\n",
        "        \"pct_short_side_lt_16px\": round(float((s < 16).mean() * 100), 2),\n",
        "        \"pct_short_side_lt_32px\": round(float((s < 32).mean() * 100), 2),\n",
        "        \"median_width_px\": round(float(np.median(widths)), 2),\n",
        "        \"median_height_px\": round(float(np.median(heights)), 2),\n",
        "    }\n",
        "\n",
        "\n",
        "train_box_stats = box_stats(DATA_ROOT, \"train\", IMG_SIZE)\n",
        "print(\"Training box statistics:\", train_box_stats)\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# 4) MODEL YAML  -  every head index is computed, never typed\n",
        "# ==============================================================================\n",
        "\n",
        "def build_model_yaml(num_classes, img_size, window):\n",
        "    \"\"\"Return (yaml_text, layer_index_map). Absolute layer numbers come from `idx`.\"\"\"\n",
        "    c3, c4, c5 = CFG.SWIN_EXPECTED_CHANNELS\n",
        "    F, R = CFG.FPN_CHANNELS, CFG.FPN_REPEATS\n",
        "    rows, idx = [], {}\n",
        "\n",
        "    def add(section, name, spec):\n",
        "        rows.append((section, name, spec))\n",
        "        idx[name] = len(rows) - 1\n",
        "\n",
        "    # ---- backbone: layer 0 returns [P3, P4, P5]; layers 1-3 pick one each ---------\n",
        "    add(\"backbone\", \"swin\",\n",
        "        f\"[-1, 1, SwinBackbone, ['{CFG.SWIN_MODEL}', {CFG.SWIN_PRETRAINED}, {img_size}, \"\n",
        "        f\"{window}, {CFG.SWIN_DROP_PATH_RATE}, {CFG.SWIN_GRAD_CKPT}]]\")\n",
        "    add(\"backbone\", \"P3\", f\"[{idx['swin']}, 1, Index, [{c3}, 0]]\")\n",
        "    add(\"backbone\", \"P4\", f\"[{idx['swin']}, 1, Index, [{c4}, 1]]\")\n",
        "    add(\"backbone\", \"P5\", f\"[{idx['swin']}, 1, Index, [{c5}, 2]]\")\n",
        "\n",
        "    # ---- head: rtdetr-l.yaml with absolute indices resolved from `idx` -------------\n",
        "    add(\"head\", \"proj5\", f\"[{idx['P5']}, 1, Conv, [{F}, 1, 1, None, 1, 1, False]]\")\n",
        "    add(\"head\", \"aifi\", f\"[-1, 1, AIFI, [{CFG.AIFI_FFN_DIM}, {CFG.AIFI_HEADS}]]\")\n",
        "    add(\"head\", \"Y5\", f\"[-1, 1, Conv, [{F}, 1, 1]]\")\n",
        "    add(\"head\", \"up5\", \"[-1, 1, nn.Upsample, [None, 2, 'nearest']]\")\n",
        "    add(\"head\", \"proj4\", f\"[{idx['P4']}, 1, Conv, [{F}, 1, 1, None, 1, 1, False]]\")\n",
        "    add(\"head\", \"cat4\", \"[[-2, -1], 1, Concat, [1]]\")\n",
        "    add(\"head\", \"fpn4\", f\"[-1, {R}, RepC3, [{F}]]\")\n",
        "    add(\"head\", \"Y4\", f\"[-1, 1, Conv, [{F}, 1, 1]]\")\n",
        "    add(\"head\", \"up4\", \"[-1, 1, nn.Upsample, [None, 2, 'nearest']]\")\n",
        "    add(\"head\", \"proj3\", f\"[{idx['P3']}, 1, Conv, [{F}, 1, 1, None, 1, 1, False]]\")\n",
        "    add(\"head\", \"cat3\", \"[[-2, -1], 1, Concat, [1]]\")\n",
        "    add(\"head\", \"X3\", f\"[-1, {R}, RepC3, [{F}]]\")\n",
        "    add(\"head\", \"down3\", f\"[-1, 1, Conv, [{F}, 3, 2]]\")\n",
        "    add(\"head\", \"catY4\", f\"[[-1, {idx['Y4']}], 1, Concat, [1]]\")\n",
        "    add(\"head\", \"F4\", f\"[-1, {R}, RepC3, [{F}]]\")\n",
        "    add(\"head\", \"down4\", f\"[-1, 1, Conv, [{F}, 3, 2]]\")\n",
        "    add(\"head\", \"catY5\", f\"[[-1, {idx['Y5']}], 1, Concat, [1]]\")\n",
        "    add(\"head\", \"F5\", f\"[-1, {R}, RepC3, [{F}]]\")\n",
        "    add(\"head\", \"decoder\", f\"[[{idx['X3']}, {idx['F4']}, {idx['F5']}], 1, RTDETRDecoder, [nc]]\")\n",
        "\n",
        "    out = {\"backbone\": [], \"head\": []}\n",
        "    for i, (section, name, spec) in enumerate(rows):\n",
        "        out[section].append(f\"  - {spec}  # [{i}] {name}\")\n",
        "\n",
        "    text = (\n",
        "        f\"nc: {num_classes}\\n\\n\"\n",
        "        f\"scales:\\n  {CFG.RTDETR_SCALE}: [1.00, 1.00, {CFG.YAML_MAX_CHANNELS}]\\n\\n\"\n",
        "        \"backbone:\\n\" + \"\\n\".join(out[\"backbone\"]) + \"\\n\\n\"\n",
        "        \"head:\\n\" + \"\\n\".join(out[\"head\"]) + \"\\n\"\n",
        "    )\n",
        "    return text, idx\n",
        "\n",
        "\n",
        "MODEL_YAML = Path(\"/content/swin_rtdetr_l_corrected.yaml\")   # keep digits out of this name\n",
        "_yaml_text, LAYER = build_model_yaml(NUM_CLASSES, IMG_SIZE, SWIN_WINDOW)\n",
        "yaml.safe_load(_yaml_text)                                      # must parse\n",
        "MODEL_YAML.write_text(_yaml_text)\n",
        "\n",
        "CFG.RUN_NAME = (\n",
        "    f\"Swin-{CFG.SWIN_VARIANT}_RTDETR_{'focalciou' if CFG.LOSS == 'focal_ciou' else 'nativeloss'}_\"\n",
        "    f\"{'cocohead' if CFG.TRANSFER_HEAD else 'scratchhead'}_\"\n",
        "    f\"{str(CFG.TIME_HOURS) + 'h' if CFG.TIME_HOURS else str(CFG.EPOCHS) + 'ep'}_\"\n",
        "    f\"{IMG_SIZE}px_lr{CFG.LR0}_seed{CFG.SEED}\"\n",
        ")\n",
        "\n",
        "print(\"\\nModel YAML written to:\", MODEL_YAML)\n",
        "print(_yaml_text)\n",
        "print(\"Layer map:\", \", \".join(f\"{k}={v}\" for k, v in LAYER.items()))\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# 5) FRESH ULTRALYTICS IMPORT, MODEL BUILD, WIRING CHECK\n",
        "# ==============================================================================\n",
        "\n",
        "for _n in [n for n in list(sys.modules) if n == \"ultralytics\" or n.startswith(\"ultralytics.\")]:\n",
        "    del sys.modules[_n]\n",
        "importlib.invalidate_caches()\n",
        "\n",
        "import ultralytics\n",
        "from ultralytics import RTDETR\n",
        "import ultralytics.nn.tasks as tasks\n",
        "from ultralytics.nn.modules.swin_backbone import SwinBackbone\n",
        "from ultralytics.models.utils.focal_ciou_loss import FocalCIoURTDETRLoss\n",
        "\n",
        "tasks.SwinBackbone = SwinBackbone      # parse_model resolves custom modules via tasks globals\n",
        "\n",
        "if not hasattr(tasks, \"Index\"):\n",
        "    raise RuntimeError(\n",
        "        f\"Ultralytics {ultralytics.__version__} has no `Index` module, which the Swin YAML \"\n",
        "        \"needs. Install a newer version (and re-run the baseline on the same version).\"\n",
        "    )\n",
        "\n",
        "_sig = list(inspect.signature(SwinBackbone.__init__).parameters)\n",
        "_want_sig = [\"self\", \"model_name\", \"pretrained\", \"img_size\", \"window_size\",\n",
        "             \"drop_path_rate\", \"grad_checkpointing\"]\n",
        "if _sig != _want_sig:\n",
        "    raise RuntimeError(f\"Unexpected SwinBackbone signature: {_sig}\")\n",
        "\n",
        "try:\n",
        "    from ultralytics.utils import DEFAULT_CFG_DICT\n",
        "except ImportError:\n",
        "    from ultralytics.cfg import DEFAULT_CFG_DICT\n",
        "\n",
        "print(\"\\nUltralytics:\", ultralytics.__version__, \"| timm:\", importlib.metadata.version(\"timm\"))\n",
        "\n",
        "print(\"\\n\" + \"=\" * 78)\n",
        "print(\"BUILDING SWIN-RT-DETR\")\n",
        "print(\"=\" * 78)\n",
        "model = RTDETR(str(MODEL_YAML))\n",
        "model.info(verbose=True)\n",
        "\n",
        "\n",
        "def check_wiring(net, imgsz, device):\n",
        "    \"\"\"The decoder must receive [X3, F4, F5] = 256 ch at strides 8 / 16 / 32.\"\"\"\n",
        "    dec = net.model[-1]\n",
        "    want_f = [LAYER[\"X3\"], LAYER[\"F4\"], LAYER[\"F5\"]]\n",
        "    if list(dec.f) != want_f:\n",
        "        raise RuntimeError(f\"Decoder reads layers {list(dec.f)}, expected {want_f}\")\n",
        "\n",
        "    seen = []\n",
        "\n",
        "    def _grab(module, args):\n",
        "        seen.extend(tuple(t.shape[1:]) for t in args[0])\n",
        "\n",
        "    handle = dec.register_forward_pre_hook(_grab)\n",
        "    try:\n",
        "        net.to(device).eval()\n",
        "        with torch.no_grad():\n",
        "            net(torch.zeros(1, 3, imgsz, imgsz, device=device))\n",
        "    finally:\n",
        "        handle.remove()\n",
        "\n",
        "    want = [(CFG.FPN_CHANNELS, imgsz // s, imgsz // s) for s in (8, 16, 32)]\n",
        "    if seen != want:\n",
        "        raise RuntimeError(f\"Decoder inputs (C,H,W) = {seen}, expected {want}\")\n",
        "    return seen\n",
        "\n",
        "\n",
        "def make_criterion(nc):\n",
        "    \"\"\"Loss for LOSS='focal_ciou'; None keeps Ultralytics' native RT-DETR loss.\"\"\"\n",
        "    if CFG.LOSS != \"focal_ciou\":\n",
        "        return None\n",
        "    return FocalCIoURTDETRLoss(\n",
        "        nc=nc, gamma=CFG.FOCAL_GAMMA, alpha=CFG.FOCAL_ALPHA, loss_gain=dict(CFG.LOSS_GAIN)\n",
        "    )\n",
        "\n",
        "\n",
        "class LossSelfTestFailed(RuntimeError):\n",
        "    pass\n",
        "\n",
        "\n",
        "def loss_selftest(net, device):\n",
        "    \"\"\"One forward/backward pass on a synthetic batch. Proves that the configured loss runs,\n",
        "    is finite, sends gradients into the Swin backbone and (focal_ciou) is really used.\"\"\"\n",
        "    crit = make_criterion(NUM_CLASSES)\n",
        "    if crit is not None:\n",
        "        net.criterion = crit\n",
        "    report = {\"loss\": CFG.LOSS}\n",
        "    try:\n",
        "        batch = {\n",
        "            \"img\": torch.rand(2, 3, IMG_SIZE, IMG_SIZE, device=device),\n",
        "            \"batch_idx\": torch.tensor([0.0, 0.0, 1.0], device=device),\n",
        "            \"cls\": torch.tensor([[0.0], [float(min(1, NUM_CLASSES - 1))], [0.0]], device=device),\n",
        "            \"bboxes\": torch.tensor([[0.50, 0.50, 0.20, 0.20],\n",
        "                                    [0.30, 0.60, 0.10, 0.15],\n",
        "                                    [0.70, 0.40, 0.25, 0.30]], device=device),\n",
        "        }\n",
        "        net.to(device).train()\n",
        "        out = net.loss(batch)\n",
        "        total = out[0] if isinstance(out, (tuple, list)) else out\n",
        "        items = out[1] if isinstance(out, (tuple, list)) and len(out) > 1 else None\n",
        "        total.backward()\n",
        "\n",
        "        report[\"total\"] = round(float(total.detach()), 4)\n",
        "        if items is not None:\n",
        "            report[\"box_cls_l1_items\"] = [round(float(v), 4) for v in items]\n",
        "        if not bool(torch.isfinite(total).item()):\n",
        "            raise LossSelfTestFailed(f\"the loss is not finite: {report['total']}\")\n",
        "        if not any(p.grad is not None and float(p.grad.abs().max()) > 0\n",
        "                   for p in net.model[0].parameters()):\n",
        "            raise LossSelfTestFailed(\"no gradient reaches the Swin backbone\")\n",
        "        if crit is not None:\n",
        "            report[\"focal_calls\"], report[\"ciou_calls\"] = crit.fl.calls, crit.n_ciou_calls\n",
        "            if crit.fl.calls == 0 or crit.n_ciou_calls == 0:\n",
        "                raise LossSelfTestFailed(\n",
        "                    \"the focal/CIoU loss was NOT used by the model (its loss path was ignored)\"\n",
        "                )\n",
        "    except LossSelfTestFailed:\n",
        "        raise\n",
        "    except Exception as exc:                 # e.g. an unexpected batch format in a newer version\n",
        "        report[\"error\"] = f\"{type(exc).__name__}: {exc}\"[:300]\n",
        "        print(\"WARNING: the loss self-test could not run:\", report[\"error\"])\n",
        "        print(\"         Training will still start; if it stops at iteration 1, send me the traceback.\")\n",
        "    finally:\n",
        "        net.zero_grad(set_to_none=True)\n",
        "    print(\"Loss self-test:\", report)\n",
        "    return report\n",
        "\n",
        "\n",
        "print(\"\\nChecking full-detector wiring on\", DEVICE, \"...\")\n",
        "WIRING_SEEN = check_wiring(model.model, IMG_SIZE, DEVICE)\n",
        "print(\"Decoder reads layers\", list(model.model.model[-1].f), \"with maps (C,H,W):\", WIRING_SEEN)\n",
        "LOSS_CHECK = loss_selftest(model.model, DEVICE)\n",
        "\n",
        "model.model.cpu()\n",
        "if DEVICE.type == \"cuda\":\n",
        "    torch.cuda.empty_cache()\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# 6) TRAINER: COCO neck/decoder transfer + separate backbone / head LR\n",
        "# ==============================================================================\n",
        "\n",
        "from ultralytics.models.rtdetr.train import RTDETRTrainer\n",
        "\n",
        "# Checkpoint loader: attempt_load_one_weight was replaced by load_checkpoint in 8.3.193.\n",
        "try:\n",
        "    from ultralytics.nn.tasks import load_checkpoint as _load_checkpoint\n",
        "\n",
        "    def load_pretrained_model(name):\n",
        "        try:\n",
        "            return _load_checkpoint(name, device=\"cpu\", fuse=False)[0]\n",
        "        except TypeError:                                  # different signature: use defaults\n",
        "            return _load_checkpoint(name)[0]\n",
        "except ImportError:\n",
        "    from ultralytics.nn.tasks import attempt_load_one_weight as _attempt_load\n",
        "\n",
        "    def load_pretrained_model(name):\n",
        "        return _attempt_load(name)[0]\n",
        "\n",
        "TRANSFER_REPORT = {\"enabled\": CFG.TRANSFER_HEAD, \"source\": CFG.PRETRAINED_CKPT}\n",
        "OPT_GROUPS = []\n",
        "\n",
        "\n",
        "def _kind(m):\n",
        "    return type(m).__name__\n",
        "\n",
        "\n",
        "def transfer_rtdetr_head(dst_model):\n",
        "    \"\"\"Copy AIFI + FPN/PAN + decoder tensors from the COCO rtdetr-l.pt into dst_model.\n",
        "\n",
        "    Layer numbers differ (head starts at 10 there, at 4 here), so keys are remapped by\n",
        "    position inside the head. The three 1x1 input projections are skipped because their\n",
        "    inputs come from a different backbone; class-dependent tensors (nc != 80) drop out\n",
        "    through the shape check.\n",
        "    \"\"\"\n",
        "    src_model = load_pretrained_model(CFG.PRETRAINED_CKPT).float()\n",
        "\n",
        "    def head_start(layers):\n",
        "        for i, m in enumerate(layers):\n",
        "            if _kind(m) == \"AIFI\":\n",
        "                return i - 1                   # a 1x1 input-projection Conv precedes AIFI\n",
        "        raise RuntimeError(\"AIFI layer not found\")\n",
        "\n",
        "    src_layers, dst_layers = list(src_model.model), list(dst_model.model)\n",
        "    s0, d0 = head_start(src_layers), head_start(dst_layers)\n",
        "    src_types = [_kind(m) for m in src_layers[s0:]]\n",
        "    dst_types = [_kind(m) for m in dst_layers[d0:]]\n",
        "    if src_types != dst_types:\n",
        "        raise RuntimeError(\n",
        "            \"Head layouts differ, cannot remap weights.\\n\"\n",
        "            f\"  {CFG.PRETRAINED_CKPT}: {src_types}\\n  this model: {dst_types}\"\n",
        "        )\n",
        "\n",
        "    skip = {0, 4, 9}                           # head-relative positions of the input projections\n",
        "    src_sd, dst_sd = src_model.state_dict(), dst_model.state_dict()\n",
        "    keep = {}\n",
        "    for key, tensor in src_sd.items():\n",
        "        parts = key.split(\".\", 2)              # model.<layer>.<rest>\n",
        "        if len(parts) < 3 or parts[0] != \"model\" or not parts[1].isdigit():\n",
        "            continue\n",
        "        rel = int(parts[1]) - s0\n",
        "        if rel < 0 or rel in skip:\n",
        "            continue\n",
        "        new_key = f\"model.{d0 + rel}.{parts[2]}\"\n",
        "        if new_key in dst_sd and dst_sd[new_key].shape == tensor.shape:\n",
        "            keep[new_key] = tensor\n",
        "\n",
        "    if not keep:\n",
        "        raise RuntimeError(\"No tensors were transferred from the pretrained checkpoint.\")\n",
        "    dst_model.load_state_dict(keep, strict=False)\n",
        "\n",
        "    per_layer = {}\n",
        "    print(f\"\\nCOCO head transfer from {CFG.PRETRAINED_CKPT} \"\n",
        "          f\"(source head starts at layer {s0}, here at {d0}):\")\n",
        "    for k, kind in enumerate(dst_types):\n",
        "        prefix = f\"model.{d0 + k}.\"\n",
        "        total = sum(1 for n in dst_sd if n.startswith(prefix))\n",
        "        got = sum(1 for n in keep if n.startswith(prefix))\n",
        "        per_layer[f\"{d0 + k}:{kind}\"] = f\"{got}/{total}\"\n",
        "        if k in skip:\n",
        "            note = \"  (input projection: re-initialised on purpose)\"\n",
        "        elif got < total and kind != \"RTDETRDecoder\":\n",
        "            note = \"  <-- WARNING: incomplete\"\n",
        "        else:\n",
        "            note = \"\"\n",
        "        if total:\n",
        "            print(f\"  layer {d0 + k:2d} {kind:14s} {got:4d}/{total:<4d}{note}\")\n",
        "\n",
        "    n_total = len(dst_sd)\n",
        "    print(f\"  total transferred: {len(keep)}/{n_total} tensors \"\n",
        "          \"(class-dependent decoder tensors stay random)\")\n",
        "    TRANSFER_REPORT.update({\n",
        "        \"transferred_tensors\": len(keep),\n",
        "        \"model_tensors\": n_total,\n",
        "        \"skipped_input_projection_layers\": [d0 + k for k in sorted(skip)],\n",
        "        \"per_layer\": per_layer,\n",
        "    })\n",
        "\n",
        "\n",
        "class SwinRTDETRTrainer(RTDETRTrainer):\n",
        "    \"\"\"model.train() rebuilds the network from the YAML, so weight transfer and\n",
        "    optimizer groups live here rather than on the RTDETR object.\"\"\"\n",
        "\n",
        "    def get_model(self, cfg=None, weights=None, verbose=True):\n",
        "        net = super().get_model(cfg=cfg, weights=weights, verbose=verbose)\n",
        "        if weights is None and CFG.TRANSFER_HEAD:      # never overwrite resumed weights\n",
        "            transfer_rtdetr_head(net)\n",
        "        crit = make_criterion(self.data[\"nc\"])\n",
        "        if crit is not None:                           # also on resumed runs; set before the EMA copy\n",
        "            net.criterion = crit\n",
        "            print(f\"\\nLoss: focal (gamma={CFG.FOCAL_GAMMA}, alpha={CFG.FOCAL_ALPHA}) + CIoU + L1, \"\n",
        "                  f\"gains class/bbox/iou = {CFG.LOSS_GAIN['class']}/{CFG.LOSS_GAIN['bbox']}/{CFG.LOSS_GAIN['giou']}\")\n",
        "        return net\n",
        "\n",
        "    def build_optimizer(self, model, *args, **kwargs):\n",
        "        optimizer = super().build_optimizer(model, *args, **kwargs)\n",
        "        swin_ids = {id(p) for p in model.model[0].parameters()}     # layer 0 = SwinBackbone\n",
        "\n",
        "        groups = []\n",
        "        for g in optimizer.param_groups:\n",
        "            for is_swin in (False, True):      # non-Swin first: group 0 stays the bias group\n",
        "                params = [p for p in g[\"params\"] if (id(p) in swin_ids) == is_swin]\n",
        "                if not params:\n",
        "                    continue\n",
        "                ng = {k: v for k, v in g.items() if k != \"params\"}\n",
        "                ng[\"params\"] = params\n",
        "                if is_swin:\n",
        "                    ng[\"lr\"] = g[\"lr\"] * CFG.BACKBONE_LR_MULT\n",
        "                groups.append((ng, is_swin))\n",
        "\n",
        "        optimizer.param_groups.clear()\n",
        "        OPT_GROUPS.clear()\n",
        "        for ng, is_swin in groups:\n",
        "            optimizer.add_param_group(ng)\n",
        "            OPT_GROUPS.append({\n",
        "                \"part\": \"swin\" if is_swin else \"neck+decoder\",\n",
        "                \"tensors\": len(ng[\"params\"]),\n",
        "                \"elements_M\": round(sum(p.numel() for p in ng[\"params\"]) / 1e6, 3),\n",
        "                \"lr\": ng[\"lr\"],\n",
        "                \"weight_decay\": ng.get(\"weight_decay\"),\n",
        "            })\n",
        "        print(\"\\nOptimizer groups:\")\n",
        "        for g in OPT_GROUPS:\n",
        "            print(\"  \", g)\n",
        "        return optimizer\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# 7) TRAINING ARGUMENTS + BASELINE DIFF\n",
        "# ==============================================================================\n",
        "\n",
        "train_args = {\n",
        "    \"data\": str(DATA_YAML),\n",
        "    \"imgsz\": IMG_SIZE,\n",
        "    \"epochs\": CFG.EPOCHS,\n",
        "    \"batch\": CFG.BATCH_SIZE,\n",
        "    \"nbs\": CFG.NBS,\n",
        "    \"device\": 0 if torch.cuda.is_available() else \"cpu\",\n",
        "    \"seed\": CFG.SEED,\n",
        "    \"deterministic\": CFG.DETERMINISTIC,\n",
        "    \"amp\": CFG.AMP,\n",
        "    \"workers\": CFG.WORKERS,\n",
        "    \"optimizer\": CFG.OPTIMIZER,\n",
        "    \"lr0\": CFG.LR0,\n",
        "    \"lrf\": CFG.LRF,\n",
        "    \"cos_lr\": CFG.COS_LR,\n",
        "    \"momentum\": CFG.MOMENTUM,\n",
        "    \"weight_decay\": CFG.WEIGHT_DECAY,\n",
        "    \"warmup_epochs\": CFG.WARMUP_EPOCHS,\n",
        "    \"warmup_momentum\": CFG.WARMUP_MOMENTUM,\n",
        "    \"warmup_bias_lr\": CFG.WARMUP_BIAS_LR,\n",
        "    \"patience\": CFG.PATIENCE,\n",
        "    \"close_mosaic\": CFG.CLOSE_MOSAIC,\n",
        "    \"val\": CFG.VAL_EACH_EPOCH,\n",
        "    \"project\": str(PROJECT_DIR),\n",
        "    \"name\": CFG.RUN_NAME,\n",
        "    \"plots\": True,\n",
        "    \"save\": True,\n",
        "    \"verbose\": True,\n",
        "}\n",
        "train_args.update(CFG.AUG)\n",
        "if CFG.TIME_HOURS:\n",
        "    train_args[\"time\"] = CFG.TIME_HOURS\n",
        "if CFG.CACHE:\n",
        "    train_args[\"cache\"] = CFG.CACHE\n",
        "\n",
        "# Data-side settings copied from the baseline so both models see identical data.\n",
        "_INHERIT = [\"hsv_h\", \"hsv_s\", \"hsv_v\", \"degrees\", \"translate\", \"scale\", \"shear\", \"perspective\",\n",
        "            \"flipud\", \"fliplr\", \"bgr\", \"mosaic\", \"mixup\", \"cutmix\", \"copy_paste\", \"close_mosaic\"]\n",
        "INHERITED = {}\n",
        "if CFG.INHERIT_FROM_BASELINE and CFG.BASELINE_ARGS_YAML and Path(CFG.BASELINE_ARGS_YAML).exists():\n",
        "    _base_args = yaml.safe_load(Path(CFG.BASELINE_ARGS_YAML).read_text()) or {}\n",
        "    for _k in _INHERIT:\n",
        "        if _k in _base_args:\n",
        "            _cur = train_args.get(_k, \"<default>\")\n",
        "            if _base_args[_k] != _cur:\n",
        "                INHERITED[_k] = {\"was\": _cur, \"now\": _base_args[_k]}\n",
        "            train_args[_k] = _base_args[_k]\n",
        "    print(f\"\\nAugmentation copied from the baseline ({len(INHERITED)} values changed):\")\n",
        "    for _k, _v in INHERITED.items():\n",
        "        print(f\"   {_k:12s} {_v['was']!r} -> {_v['now']!r}\")\n",
        "\n",
        "dropped_args = {k: v for k, v in train_args.items() if k not in DEFAULT_CFG_DICT}\n",
        "for _k in dropped_args:\n",
        "    train_args.pop(_k)\n",
        "if dropped_args:\n",
        "    print(\"\\nArguments unsupported by this Ultralytics version were dropped:\")\n",
        "    print(json.dumps(dropped_args, indent=2, default=str))\n",
        "\n",
        "_WATCH = [\n",
        "    \"imgsz\", \"epochs\", \"batch\", \"nbs\", \"optimizer\", \"lr0\", \"lrf\", \"momentum\", \"weight_decay\",\n",
        "    \"cos_lr\", \"warmup_epochs\", \"warmup_momentum\", \"warmup_bias_lr\", \"patience\", \"close_mosaic\",\n",
        "    \"amp\", \"seed\", \"hsv_h\", \"hsv_s\", \"hsv_v\", \"degrees\", \"translate\", \"scale\", \"shear\",\n",
        "    \"perspective\", \"flipud\", \"fliplr\", \"bgr\", \"mosaic\", \"mixup\", \"cutmix\", \"copy_paste\",\n",
        "    \"multi_scale\", \"rect\", \"fraction\", \"freeze\",\n",
        "]\n",
        "\n",
        "\n",
        "def diff_against_baseline(path, args):\n",
        "    \"\"\"Settings (from a watch list) that differ between the baseline args.yaml and this run.\"\"\"\n",
        "    if not path:\n",
        "        return None\n",
        "    p = Path(path)\n",
        "    if not p.exists():\n",
        "        print(f\"Baseline args file not found: {p}\")\n",
        "        return None\n",
        "    base = yaml.safe_load(p.read_text()) or {}\n",
        "    rows = {}\n",
        "    for k in _WATCH:\n",
        "        mine = args.get(k, DEFAULT_CFG_DICT.get(k))\n",
        "        theirs = base.get(k, DEFAULT_CFG_DICT.get(k))\n",
        "        if mine != theirs:\n",
        "            rows[k] = {\"baseline\": theirs, \"this_run\": mine}\n",
        "    return rows\n",
        "\n",
        "\n",
        "BASELINE_DIFF = diff_against_baseline(CFG.BASELINE_ARGS_YAML, train_args)\n",
        "if BASELINE_DIFF is None:\n",
        "    print(\"\\n[baseline diff] BASELINE_ARGS_YAML is not set. Point it to the baseline run's \"\n",
        "          \"args.yaml to list every setting that differs from this run.\")\n",
        "elif not BASELINE_DIFF:\n",
        "    print(\"\\n[baseline diff] all watched settings are identical to the baseline.\")\n",
        "else:\n",
        "    print(\"\\n[baseline diff] settings that differ from the baseline:\")\n",
        "    for _k, _v in BASELINE_DIFF.items():\n",
        "        print(f\"   {_k:16s} baseline={_v['baseline']!r:<14} this_run={_v['this_run']!r}\")\n",
        "\n",
        "_accum = max(round(CFG.NBS / CFG.BATCH_SIZE), 1)\n",
        "print(\"\\nTraining configuration\")\n",
        "print(\"  per-step batch      :\", CFG.BATCH_SIZE)\n",
        "print(\"  nominal batch (nbs) :\", CFG.NBS)\n",
        "print(\"  accumulation (est.) :\", _accum, \"-> effective batch\", CFG.BATCH_SIZE * _accum)\n",
        "print(\"  LR neck/decoder     :\", CFG.LR0)\n",
        "print(\"  LR Swin             :\", CFG.LR0 * CFG.BACKBONE_LR_MULT)\n",
        "print(\"  Swin variant        :\", CFG.SWIN_VARIANT)\n",
        "print(\"  dataloader workers  :\", CFG.WORKERS, f\"(CPU cores: {os.cpu_count()}; Ultralytics caps workers at the core count)\",\n",
        "      \"| cache:\", CFG.CACHE or \"off\")\n",
        "print(\"  epochs / time budget:\", CFG.EPOCHS, \"/\", f\"{CFG.TIME_HOURS} h\" if CFG.TIME_HOURS else \"none\")\n",
        "if not CFG.VAL_EACH_EPOCH:\n",
        "    print(\"  NOTE: validation only after the last epoch (no early stopping / best-epoch selection)\")\n",
        "print(\"  augmentation        :\", \"copied from baseline\" if INHERITED else CFG.AUG_PRESET)\n",
        "print(\"  COCO head transfer  :\", CFG.TRANSFER_HEAD)\n",
        "print(\"  loss                :\", (f\"focal (gamma={CFG.FOCAL_GAMMA}, alpha={CFG.FOCAL_ALPHA}) + CIoU + L1\"\n",
        "                                  if CFG.LOSS == \"focal_ciou\" else \"native RT-DETR (varifocal + GIoU + L1)\"))\n",
        "if CFG.LOSS == \"focal_ciou\":\n",
        "    print(\"  NOTE: the baseline RT-DETR uses the native loss (varifocal + GIoU), so an mAP difference \"\n",
        "          \"mixes backbone and loss effects.\")\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# 7b) GPU MONITOR: is the GPU waiting for the dataloader?\n",
        "# ==============================================================================\n",
        "\n",
        "GPU_UTIL = {\"samples\": [], \"verdict\": None}\n",
        "\n",
        "\n",
        "def _sample_gpu(stop_evt, interval=5.0, verdict_after=120.0):\n",
        "    \"\"\"Sample GPU utilisation; print ONE verdict line after `verdict_after` seconds.\"\"\"\n",
        "    t0 = time.time()\n",
        "    while not stop_evt.is_set():\n",
        "        try:\n",
        "            out = subprocess.check_output(\n",
        "                [\"nvidia-smi\", \"--query-gpu=utilization.gpu\", \"--format=csv,noheader,nounits\"],\n",
        "                timeout=5,\n",
        "            ).decode().split()\n",
        "            GPU_UTIL[\"samples\"].append(float(out[0]))\n",
        "        except Exception:\n",
        "            pass\n",
        "        if GPU_UTIL[\"verdict\"] is None and GPU_UTIL[\"samples\"] and time.time() - t0 >= verdict_after:\n",
        "            mean = sum(GPU_UTIL[\"samples\"]) / len(GPU_UTIL[\"samples\"])\n",
        "            if mean >= 85:\n",
        "                msg = (\"GPU-bound: more workers will NOT help. Use a smaller Swin, a lower IMG_SIZE \"\n",
        "                       \"or a faster GPU.\")\n",
        "            elif mean >= 60:\n",
        "                msg = \"partly data-bound: try WORKERS = number of CPU cores and/or CACHE=disk.\"\n",
        "            else:\n",
        "                msg = (\"DATA-BOUND: raise WORKERS (up to the CPU core count), set CACHE=disk, \"\n",
        "                       \"and/or reduce heavy augmentation such as mosaic.\")\n",
        "            GPU_UTIL[\"verdict\"] = f\"mean GPU utilisation {mean:.0f}% -> {msg}\"\n",
        "            print(f\"\\n[gpu monitor] {GPU_UTIL['verdict']}\")\n",
        "        stop_evt.wait(interval)\n",
        "\n",
        "\n",
        "def attach_gpu_monitor(m):\n",
        "    \"\"\"Start sampling when training starts, stop when it ends. Returns the stop event.\"\"\"\n",
        "    stop = threading.Event()\n",
        "\n",
        "    def _start(trainer):\n",
        "        threading.Thread(target=_sample_gpu, args=(stop,), daemon=True).start()\n",
        "\n",
        "    def _stop(trainer):\n",
        "        stop.set()\n",
        "\n",
        "    m.add_callback(\"on_train_start\", _start)\n",
        "    m.add_callback(\"on_train_end\", _stop)\n",
        "    return stop\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# 8) TRAIN\n",
        "# ==============================================================================\n",
        "\n",
        "print(\"\\n\" + \"=\" * 78)\n",
        "print(\"STARTING TRAINING\")\n",
        "print(\"=\" * 78)\n",
        "\n",
        "_t0 = time.time()\n",
        "if CFG.RESUME_FROM:\n",
        "    print(\"RESUMING from\", CFG.RESUME_FROM)\n",
        "    model = RTDETR(CFG.RESUME_FROM)                      # the run's own args come from the checkpoint\n",
        "    _gpu_stop = attach_gpu_monitor(model)\n",
        "    model.train(trainer=SwinRTDETRTrainer, resume=True)\n",
        "else:\n",
        "    _gpu_stop = attach_gpu_monitor(model)\n",
        "    model.train(trainer=SwinRTDETRTrainer, **train_args)\n",
        "_gpu_stop.set()\n",
        "TRAIN_SECONDS = round(time.time() - _t0, 1)\n",
        "GPU_UTIL_MEAN = (round(sum(GPU_UTIL[\"samples\"]) / len(GPU_UTIL[\"samples\"]), 1)\n",
        "                 if GPU_UTIL[\"samples\"] else None)\n",
        "print(\"Mean GPU utilisation during training:\", GPU_UTIL_MEAN, \"%\")\n",
        "\n",
        "_trainer = model.trainer\n",
        "save_dir = Path(_trainer.save_dir)\n",
        "print(\"\\nTrainer accumulate:\", getattr(_trainer, \"accumulate\", None),\n",
        "      \"| batch:\", getattr(_trainer, \"batch_size\", None), \"| save_dir:\", save_dir)\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# 9) FINAL EVALUATION  (best checkpoint) + EFFICIENCY\n",
        "# ==============================================================================\n",
        "\n",
        "best_pt = save_dir / \"weights\" / \"best.pt\"\n",
        "if not best_pt.exists():\n",
        "    best_pt = save_dir / \"weights\" / \"last.pt\"\n",
        "\n",
        "\n",
        "def curves_at(box_metrics, conf, names):\n",
        "    \"\"\"Precision / recall / F1 (IoU 0.5) at a fixed confidence, from the PR curves.\"\"\"\n",
        "    try:\n",
        "        px = np.asarray(box_metrics.px, dtype=float)\n",
        "        j = int(np.argmin(np.abs(px - conf)))\n",
        "        p = np.asarray(box_metrics.p_curve, dtype=float)[:, j]\n",
        "        r = np.asarray(box_metrics.r_curve, dtype=float)[:, j]\n",
        "        f1 = np.asarray(box_metrics.f1_curve, dtype=float)[:, j]\n",
        "        return {\n",
        "            \"conf\": round(float(px[j]), 4),\n",
        "            \"iou_for_pr\": 0.5,\n",
        "            \"precision\": float(p.mean()),\n",
        "            \"recall\": float(r.mean()),\n",
        "            \"f1\": float(f1.mean()),\n",
        "            \"per_class\": {\n",
        "                names[int(c)]: {\"precision\": float(p[k]), \"recall\": float(r[k])}\n",
        "                for k, c in enumerate(box_metrics.ap_class_index)\n",
        "            },\n",
        "        }\n",
        "    except Exception as exc:\n",
        "        return {\"error\": f\"{type(exc).__name__}: {exc}\"}\n",
        "\n",
        "\n",
        "def profile_model(net, imgsz, device):\n",
        "    \"\"\"Params, GFLOPs and latency of the trained detector (forward pass only).\"\"\"\n",
        "    info = {\"imgsz\": imgsz}\n",
        "    net = deepcopy(net).float().eval()\n",
        "    info[\"params_M\"] = round(sum(p.numel() for p in net.parameters()) / 1e6, 2)\n",
        "    try:\n",
        "        net = net.fuse(verbose=False)\n",
        "    except Exception:\n",
        "        pass\n",
        "    net = net.to(device)\n",
        "    x = torch.zeros(1, 3, imgsz, imgsz, device=device)\n",
        "\n",
        "    try:\n",
        "        from torch.utils.flop_counter import FlopCounterMode\n",
        "        with torch.no_grad(), FlopCounterMode(display=False) as fc:\n",
        "            net(x)\n",
        "        info[\"gflops\"] = round(fc.get_total_flops() / 1e9, 1)\n",
        "    except Exception as exc:\n",
        "        info[\"gflops\"] = None\n",
        "        info[\"gflops_error\"] = f\"{type(exc).__name__}: {exc}\"[:200]\n",
        "\n",
        "    if device.type == \"cuda\":\n",
        "        try:\n",
        "            with torch.no_grad(), torch.autocast(\"cuda\", dtype=torch.float16):\n",
        "                for _ in range(20):\n",
        "                    net(x)\n",
        "                torch.cuda.synchronize()\n",
        "                t0 = time.perf_counter()\n",
        "                for _ in range(100):\n",
        "                    net(x)\n",
        "                torch.cuda.synchronize()\n",
        "            ms = (time.perf_counter() - t0) * 1000.0 / 100\n",
        "            info[\"latency_ms_fp16_bs1\"] = round(ms, 2)\n",
        "            info[\"fps_fp16_bs1\"] = round(1000.0 / ms, 1)\n",
        "        except Exception as exc:\n",
        "            info[\"latency_error\"] = f\"{type(exc).__name__}: {exc}\"[:200]\n",
        "\n",
        "    info[\"note\"] = (\"params before fusing; GFLOPs and latency after Conv+BN fusion, batch 1, \"\n",
        "                    \"model forward only (no pre/post-processing), FP16 autocast for latency\")\n",
        "    return info\n",
        "\n",
        "\n",
        "print(\"\\n\" + \"=\" * 78)\n",
        "print(f\"FINAL EVALUATION: {best_pt.name}, split={EVAL_SPLIT}, conf={CFG.CONF_THRESH_MAP}\")\n",
        "print(\"=\" * 78)\n",
        "\n",
        "# efficiency first: val() fuses the model in place, so params are counted on a fresh copy\n",
        "try:\n",
        "    PROFILE = profile_model(RTDETR(str(best_pt)).model, IMG_SIZE, DEVICE)\n",
        "except Exception as exc:\n",
        "    PROFILE = {\"error\": f\"{type(exc).__name__}: {exc}\"[:300]}\n",
        "print(\"Efficiency:\", json.dumps(PROFILE, indent=2))\n",
        "if DEVICE.type == \"cuda\":\n",
        "    torch.cuda.empty_cache()\n",
        "\n",
        "\n",
        "def final_eval():\n",
        "    best = RTDETR(str(best_pt))\n",
        "    res = best.val(\n",
        "        data=str(DATA_YAML), imgsz=IMG_SIZE, conf=CFG.CONF_THRESH_MAP, split=EVAL_SPLIT,\n",
        "        batch=CFG.BATCH_SIZE, device=train_args[\"device\"], project=str(PROJECT_DIR),\n",
        "        name=f\"{CFG.RUN_NAME}_val\", plots=False,\n",
        "    )\n",
        "    metrics = {k: float(v) for k, v in dict(res.results_dict).items()}\n",
        "    per_class = {}\n",
        "    print(\"\\nPer-class AP:\")\n",
        "    for k, c in enumerate(res.box.ap_class_index):\n",
        "        name = res.names[int(c)]\n",
        "        per_class[name] = {\"AP50\": float(res.box.ap50[k]), \"AP50-95\": float(res.box.ap[k])}\n",
        "        print(f\"  {name:20s} AP50={per_class[name]['AP50']:.4f} \"\n",
        "              f\"AP50-95={per_class[name]['AP50-95']:.4f}\")\n",
        "    return metrics, per_class, curves_at(res.box, CFG.CONF_THRESH_OP, res.names)\n",
        "\n",
        "\n",
        "EVAL_OK = True\n",
        "try:\n",
        "    map_metrics, per_class_ap, operating_point = final_eval()\n",
        "except Exception as exc:                     # keep the manifest even if evaluation breaks\n",
        "    import traceback\n",
        "    traceback.print_exc()\n",
        "    EVAL_OK = False\n",
        "    print(\"\\nWARNING: final evaluation failed (weights are saved). Falling back to the \"\n",
        "          \"trainer's last validation metrics (val split).\")\n",
        "    _m = getattr(_trainer, \"metrics\", None)\n",
        "    _m = getattr(_m, \"results_dict\", _m) or {}\n",
        "    map_metrics = {k: float(v) for k, v in dict(_m).items() if isinstance(v, (int, float))}\n",
        "    per_class_ap = {}\n",
        "    operating_point = {\"error\": f\"final evaluation failed: {type(exc).__name__}: {exc}\"[:300]}\n",
        "\n",
        "print(f\"\\nSUMMARY  mAP50={map_metrics.get('metrics/mAP50(B)', float('nan')):.4f}  \"\n",
        "      f\"mAP50-95={map_metrics.get('metrics/mAP50-95(B)', float('nan')):.4f}  \"\n",
        "      f\"P@{CFG.CONF_THRESH_OP}={operating_point.get('precision', float('nan')):.4f}  \"\n",
        "      f\"R@{CFG.CONF_THRESH_OP}={operating_point.get('recall', float('nan')):.4f}\")\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# 10) REPRODUCIBILITY MANIFEST + SMALL RESULTS BUNDLE\n",
        "# ==============================================================================\n",
        "\n",
        "save_dir.mkdir(parents=True, exist_ok=True)\n",
        "shutil.copy(MODEL_YAML, save_dir / MODEL_YAML.name)\n",
        "shutil.copy(SWIN_MODULE, save_dir / SWIN_MODULE.name)   # needed to unpickle the checkpoints\n",
        "shutil.copy(LOSS_MODULE, save_dir / LOSS_MODULE.name)   # the loss is stored inside the checkpoints too\n",
        "\n",
        "manifest = {\n",
        "    \"environment\": {\n",
        "        \"python\": platform.python_version(),\n",
        "        \"torch\": torch.__version__,\n",
        "        \"ultralytics\": ultralytics.__version__,\n",
        "        \"timm\": importlib.metadata.version(\"timm\"),\n",
        "        \"cuda_available\": torch.cuda.is_available(),\n",
        "        \"gpu\": torch.cuda.get_device_name(0) if torch.cuda.is_available() else \"cpu\",\n",
        "    },\n",
        "    \"dataset\": {\n",
        "        \"root\": str(DATA_ROOT),\n",
        "        \"yaml\": str(DATA_YAML),\n",
        "        \"roboflow_workspace\": CFG.RF_WORKSPACE,\n",
        "        \"roboflow_project\": CFG.RF_PROJECT,\n",
        "        \"roboflow_version\": CFG.RF_VERSION,\n",
        "        \"num_classes\": NUM_CLASSES,\n",
        "        \"class_names\": CLASS_NAMES,\n",
        "        \"evaluation_split\": EVAL_SPLIT,\n",
        "    },\n",
        "    \"backbone\": {\n",
        "        \"name\": CFG.SWIN_MODEL,\n",
        "        \"pretrained\": CFG.SWIN_PRETRAINED,\n",
        "        \"pretrained_weights_source\": SWIN_WEIGHTS_SOURCE,\n",
        "        \"params_M\": SWIN_PARAMS_M,\n",
        "        \"input_size\": IMG_SIZE,\n",
        "        \"window_size\": SWIN_WINDOW,\n",
        "        \"drop_path_rate_requested\": CFG.SWIN_DROP_PATH_RATE,\n",
        "        \"drop_path_rate_applied\": APPLIED_DROP_PATH,\n",
        "        \"grad_checkpointing\": CFG.SWIN_GRAD_CKPT,\n",
        "        \"input_normalisation\": \"ImageNet mean/std applied inside SwinBackbone\",\n",
        "        \"expected_output_channels\": CFG.SWIN_EXPECTED_CHANNELS,\n",
        "        \"expected_output_reductions\": CFG.SWIN_EXPECTED_REDUCTIONS,\n",
        "        \"smoke_attempts\": smoke_attempts,\n",
        "    },\n",
        "    \"detector\": {\n",
        "        \"variant\": f\"RT-DETR-L head with Swin-{CFG.SWIN_VARIANT} backbone ({CFG.SWIN_MODEL})\",\n",
        "        \"yaml\": str(MODEL_YAML),\n",
        "        \"layer_map\": LAYER,\n",
        "        \"decoder_input_maps_CHW\": WIRING_SEEN,\n",
        "        \"fpn_channels\": CFG.FPN_CHANNELS,\n",
        "        \"aifi_ffn_dim\": CFG.AIFI_FFN_DIM,\n",
        "        \"aifi_heads\": CFG.AIFI_HEADS,\n",
        "        \"fpn_repeats\": CFG.FPN_REPEATS,\n",
        "        \"native_rtdetr_loss\": CFG.LOSS == \"native\",\n",
        "        \"loss\": {\n",
        "            \"type\": CFG.LOSS,\n",
        "            \"classification\": (f\"sigmoid focal loss (gamma={CFG.FOCAL_GAMMA}, alpha={CFG.FOCAL_ALPHA}), hard targets\"\n",
        "                               if CFG.LOSS == \"focal_ciou\" else \"varifocal loss (Ultralytics default)\"),\n",
        "            \"box\": \"CIoU + L1\" if CFG.LOSS == \"focal_ciou\" else \"GIoU + L1\",\n",
        "            \"gains\": (CFG.LOSS_GAIN if CFG.LOSS == \"focal_ciou\"\n",
        "                      else \"Ultralytics defaults (class 1, bbox 5, giou 2)\"),\n",
        "            \"matcher_cost\": \"class + L1 + GIoU (Ultralytics default, unchanged)\",\n",
        "            \"implementation\": (\"FocalCIoURTDETRLoss subclass, no global monkey patches\"\n",
        "                               if CFG.LOSS == \"focal_ciou\" else \"native\"),\n",
        "            \"selftest\": LOSS_CHECK,\n",
        "        },\n",
        "    },\n",
        "    \"initialization\": {\n",
        "        \"swin_backbone\": \"timm ImageNet-22k (fine-tuned on 1k) weights\" if CFG.SWIN_PRETRAINED else \"random\",\n",
        "        \"neck_decoder\": (f\"COCO {CFG.PRETRAINED_CKPT}, remapped by head position; the three \"\n",
        "                         \"input projections are re-initialised\") if CFG.TRANSFER_HEAD else \"random\",\n",
        "        \"transfer_report\": TRANSFER_REPORT,\n",
        "    },\n",
        "    \"training\": {\n",
        "        \"args_used\": train_args,\n",
        "        \"optimizer_groups\": OPT_GROUPS,\n",
        "        \"backbone_lr_mult\": CFG.BACKBONE_LR_MULT,\n",
        "        \"estimated_accumulation\": _accum,\n",
        "        \"trainer_accumulate\": getattr(_trainer, \"accumulate\", None),\n",
        "        \"trainer_batch_size\": getattr(_trainer, \"batch_size\", None),\n",
        "        \"train_seconds\": TRAIN_SECONDS,\n",
        "        \"time_budget_hours\": CFG.TIME_HOURS,\n",
        "        \"workers\": CFG.WORKERS,\n",
        "        \"cpu_cores\": os.cpu_count(),\n",
        "        \"cache\": CFG.CACHE or None,\n",
        "        \"gpu_util_mean_pct\": GPU_UTIL_MEAN,\n",
        "        \"epochs_configured\": CFG.EPOCHS,\n",
        "        \"epochs_planned_final\": getattr(_trainer, \"epochs\", None),\n",
        "        \"last_epoch_completed\": (getattr(_trainer, \"epoch\", -1) + 1) if hasattr(_trainer, \"epoch\") else None,\n",
        "        \"resumed_from\": CFG.RESUME_FROM or None,\n",
        "        \"seed\": CFG.SEED,\n",
        "        \"deterministic\": CFG.DETERMINISTIC,\n",
        "    },\n",
        "    \"augmentation\": {\"preset\": CFG.AUG_PRESET, \"overrides\": CFG.AUG,\n",
        "                     \"copied_from_baseline\": INHERITED},\n",
        "    \"baseline_diff\": BASELINE_DIFF,\n",
        "    \"train_box_stats\": train_box_stats,\n",
        "    \"evaluation\": {\n",
        "        \"checkpoint\": best_pt.name,\n",
        "        \"final_eval_ok\": EVAL_OK,\n",
        "        \"split\": EVAL_SPLIT,\n",
        "        \"conf_for_map\": CFG.CONF_THRESH_MAP,\n",
        "        \"note\": (\"RT-DETR is end-to-end and NMS-free, so no NMS IoU threshold applies. \"\n",
        "                 \"Operating-point P/R/F1 are read from the PR curves (IoU 0.5) of the \"\n",
        "                 \"conf=0.001 run at the confidence below.\"),\n",
        "        \"map_metrics\": map_metrics,\n",
        "        \"per_class_ap\": per_class_ap,\n",
        "        \"operating_point\": operating_point,\n",
        "    },\n",
        "    \"efficiency\": PROFILE,\n",
        "}\n",
        "\n",
        "manifest_path = save_dir / \"reproducibility_manifest.json\"\n",
        "with open(manifest_path, \"w\") as f:\n",
        "    json.dump(manifest, f, indent=2, default=str)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 78)\n",
        "print(\"MANIFEST\")\n",
        "print(\"=\" * 78)\n",
        "print(json.dumps(manifest, indent=2, default=str))\n",
        "print(\"\\nSaved manifest  :\", manifest_path)\n",
        "print(\"Saved model YAML:\", save_dir / MODEL_YAML.name)\n",
        "print(\"Saved Swin module (needed to reload weights):\", save_dir / SWIN_MODULE.name)\n",
        "print(\"Saved loss module (needed to reload weights):\", save_dir / LOSS_MODULE.name)\n",
        "\n",
        "if CFG.DOWNLOAD_SMALL_BUNDLE:\n",
        "    bundle_path = Path(f\"/content/{save_dir.name}_results_no_weights.zip\")\n",
        "    with zipfile.ZipFile(bundle_path, \"w\", zipfile.ZIP_DEFLATED) as archive:\n",
        "        for file_path in save_dir.rglob(\"*\"):\n",
        "            if file_path.is_file() and file_path.suffix != \".pt\":\n",
        "                archive.write(file_path, file_path.relative_to(save_dir.parent))\n",
        "    print(f\"\\nResults bundle: {bundle_path} ({bundle_path.stat().st_size / 1e6:.2f} MB)\")\n",
        "    try:\n",
        "        from google.colab import files\n",
        "        files.download(str(bundle_path))\n",
        "    except Exception as exc:\n",
        "        print(\"Automatic Colab download unavailable:\", exc)\n",
        "\n",
        "print(\"\\nDONE.\")"
      ]
    }
  ]
}
