        "    # so values above os.cpu_count() change nothing. The GPU monitor below tells you whether\n",
        "    # data loading is the bottleneck at all.\n",
        "    WORKERS = int(os.environ.get(\"WORKERS\", min(8, os.cpu_count() or 2)))\n",
        "    # Cache decoded images: \"\" = off, \"disk\" = .npy files next to the images (needs disk, not RAM),\n",
        "    # \"ram\" = fastest but ~7 GB for ~6k images at 640 px (Ultralytics turns it off if RAM is short).\n",
        "    CACHE = os.environ.get(\"CACHE\", \"\").strip().lower()\n",
        "\n",
        "    # ---- Swin size: bigger = slower (rough cost vs base: small ~0.6x, tiny ~0.4x) ------\n",
        "    SWIN_PRESETS = {                      # variant: (timm model, attention window)\n",
        "        \"base\": (\"swin_base_patch4_window12_384.ms_in22k_ft_in1k\", 12),\n",
        "        \"small\": (\"swin_small_patch4_window7_224.ms_in22k_ft_in1k\", 7),\n",
        "        \"tiny\": (\"swin_tiny_patch4_window7_224.ms_in22k_ft_in1k\", 7),\n",
