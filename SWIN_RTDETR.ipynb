        "    # (saved in the manifest) and give the baseline the same number.\n",
        "    _th = os.environ.get(\"TIME_HOURS\", \"0\").strip().lower()\n",
        "    TIME_HOURS = None if _th in (\"\", \"0\", \"none\") else float(_th)\n",
        "    # False: validate only after the last epoch (saves minutes per epoch; disables early\n",
