        "# ==============================================================================\n",
        "# 0) CONFIGURATION  -  edit only this block\n",
        "# ==============================================================================\n",
        "\n",
        "class CFG:\n",
        "    # ---- Package versions -------------------------------------------------------\n",
        "    # Use the SAME Ultralytics version as the RT-DETR baseline (see its log/manifest).\n",
