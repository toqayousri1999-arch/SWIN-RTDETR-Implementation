        "\n",
        "    # ---- Dataset (Roboflow) --------------------------------------------------------\n",
        "    RF_WORKSPACE = \"siewchinyip-outlook-my\"\n",
        "    RF_PROJECT = \"sixray\"\n",
        "    RF_VERSION = 4\n",
        "    DATA_YAML = os.environ.get(\"DATA_YAML\", \"\")     # optional explicit path (skips search/download)\n",
        "\n",
        "    # ---- Backbone -------------------------------------------------------------------\n",
        "    SWIN_MODEL = SWIN_PRESETS[SWIN_VARIANT][0]\n",
        "    SWIN_PRETRAINED = True\n",
        "    SWIN_DROP_PATH_RATE = 0.1\n",
